{
  "manifest_version": 2,
  "name": "JustNewTab",
  "version": "0.1.0",
  "description": "一款多浏览器可用的新标签页插件",
  "browser_url_overrides": {
    "newtab": "src/newtab/index.html"
  },
  "permissions": ["storage", "bookmarks"],
  "icons": {
    "16": "public/icons/icon-16.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  }
}
