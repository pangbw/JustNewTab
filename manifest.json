{
  "manifest_version": 3,
  "name": "JustNewTab",
  "version": "0.1.0",
  "description": "一款多浏览器可用的新标签页插件",
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "permissions": ["storage", "bookmarks", "tabs"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
